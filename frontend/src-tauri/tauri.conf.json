{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Recall",
    "version": "0.4.0",
    "identifier": "com.meetily.ai",
    "build": {
        "frontendDist": "../out",
        "devUrl": "http://localhost:3118",
        "beforeDevCommand": "pnpm dev",
        "beforeBuildCommand": "pnpm build"
    },
    "app": {
        "windows": [
            {
                "title": "Recall",
                "width": 1100,
                "height": 700,
                "minWidth": 1000,
                "minHeight": 640,
                "resizable": true,
                "fullscreen": false,
                "theme": "Light",
                "decorations": true
            }
        ],
        "macOSPrivateApi": true,
        "security": {
            "csp": {
                "default-src": "'self'",
                "style-src": "'self' 'unsafe-inline'",
                "img-src": "'self' asset: https://asset.localhost data:",
                "connect-src": "'self' ipc: http://ipc.localhost http://localhost:11434 http://localhost:5167 http://localhost:8178 https://api.ollama.ai"
            },
            "assetProtocol": {
                "enable": true,
                "scope": [
                    "$APPDATA/**"
                ]
            },
            "capabilities": [
                {
                    "identifier": "main",
                    "description": "Main window capability. Least privilege: the renderer performs NO filesystem access itself. Every read and write goes through a Rust command that validates its path. Phase F2 removed the whole `fs` permission family (fs:default, fs:allow-read-file, fs:read-all, fs:write-all, fs:allow-app-read, fs:allow-app-write, fs:allow-download-write, fs:allow-download-read, fs:scope-download, fs:scope) after verifying that `@tauri-apps/plugin-fs` had zero imports in the frontend; `appDataDir()` comes from the read-only `core:path` API, which is retained.",
                    "windows": [
                        "main"
                    ],
                    "permissions": [
                        "core:path:default",
                        "core:event:default",
                        "core:window:default",
                        "core:app:default",
                        "core:resources:default",
                        "core:menu:default",
                        "core:tray:default",
                        "core:window:allow-set-title",
                        "store:default",
                        "notification:default",
                        "notification:allow-is-permission-granted"
                    ]
                }
            ]
        }
    },
    "bundle": {
        "active": true,
        "publisher": "Recall",
        "targets": [
            "deb",
            "appimage",
            "msi",
            "nsis",
            "app",
            "dmg"
        ],
        "createUpdaterArtifacts": false,
        "icon": [
            "icons/icon.png",
            "icons/app_icon.icns",
            "icons/app_icon.ico"
        ],
        "resources": [
            "templates/*.json"
        ],
        "externalBin": [
            "binaries/llama-helper",
            "binaries/ffmpeg"
        ],
        "macOS": {
            "entitlements": "entitlements.plist",
            "signingIdentity": "-",
            "hardenedRuntime": true
        },
        "windows": {
            "signCommand": "powershell -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 -FilePath %1"
        }
    }
}